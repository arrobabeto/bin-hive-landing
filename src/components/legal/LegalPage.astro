---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { localizedPath, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const home = await getEntry('home', lang);
const legal = await getEntry('legal', lang);
if (!home || !legal) throw new Error(`Missing content for ${lang}`);
const { Content } = await render(legal);
const { title, description, updated } = legal.data;
---

<Layout
  lang={lang}
  title={title}
  description={description}
  content={home.data}
  anchorBase={localizedPath('/', lang)}
>
  <article class="home-container home-legal">
    <p class="home-eyebrow">
      <span class="home-eyebrow__index" aria-hidden="true">§</span>
      <span>{updated}</span>
    </p>
    <h1 class="home-h2">{title}</h1>
    <div class="home-legal__body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .home-legal {
    padding-block: var(--bh-section-y);
    max-width: 52rem;
  }
  .home-legal__body {
    margin-top: 2.5rem;
    padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    border: var(--bh-border) solid var(--bh-ink);
    background: var(--bh-white);
    box-shadow: var(--bh-shadow);
  }
  .home-legal__body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: var(--bh-text-xl);
    font-stretch: 112%;
    font-weight: 900;
    text-transform: uppercase;
  }
  .home-legal__body :global(h2:first-child) {
    margin-top: 0;
  }
  .home-legal__body :global(ul) {
    margin: 0.75rem 0;
    padding-left: 1.25rem;
    list-style: square;
  }
  .home-legal__body :global(li) {
    margin-block: 0.375rem;
  }
  .home-legal__body :global(li::marker) {
    color: var(--bh-honey-deep);
  }
  .home-legal__body :global(p),
  .home-legal__body :global(li) {
    max-width: 68ch;
  }
  .home-legal__body :global(a) {
    color: inherit;
    font-weight: 700;
    text-decoration-thickness: 2px;
  }
</style>
