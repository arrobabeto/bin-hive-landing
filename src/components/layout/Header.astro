---
import Logo from '../ui/Logo.astro';
import { bf } from '../../lib/bsi';
import type { HomeContent } from '../../lib/home-schema';
import { localizedPath, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
  nav: HomeContent['nav'];
  anchorBase?: string;
}

const { lang, nav, anchorBase = '' } = Astro.props;
const homeHref = localizedPath('/', lang);
const otherLocale: Locale = lang === 'es' ? 'en' : 'es';
const otherHref = localizedPath(Astro.url.pathname, otherLocale);
const href = (anchor: string) => `${anchorBase}${anchor}`;
---

<header class="site-header" data-menu-open="false" {...bf('shared.nav.shell', 'container')}>
  <div class="home-container site-header__bar">
    <a class="site-header__brand" href={homeHref} aria-label={nav.home_aria_label}>
      <Logo size={36} />
    </a>

    <nav class="site-header__nav" id="site-menu" aria-label={nav.menu_aria_label}>
      <ul class="site-header__links">
        {
          nav.links.map((link) => (
            <li>
              <a class="site-header__link" href={href(link.href)} {...bf(`shared.nav.${link.id}_label`, 'chrome_denied')}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="site-header__lang"
        href={otherHref}
        hreflang={otherLocale === 'es' ? 'es-MX' : 'en'}
        lang={otherLocale === 'es' ? 'es-MX' : 'en'}
        aria-label={nav.lang_aria_label}
        {...bf('shared.nav.lang_label', 'chrome_denied')}
      >
        {nav.lang_label}
      </a>
    </nav>

    <a class="home-btn site-header__cta" href={href(nav.cta_href)} {...bf('shared.nav.cta_label', 'chrome_denied')}>
      {nav.cta_label}
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-controls="site-menu"
      aria-expanded="false"
      data-label-open={nav.menu_label}
      data-label-close={nav.menu_close_aria_label}
    >
      <span class="site-header__toggle-icon" aria-hidden="true"><span></span></span>
      <span class="site-header__toggle-text" {...bf('shared.nav.menu_label', 'chrome_denied')}>{nav.menu_label}</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bh-paper);
    border-bottom: var(--bh-border) solid var(--bh-ink);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 4.25rem;
    padding-block: 0.625rem;
  }
  .site-header__brand {
    display: inline-flex;
    flex: none;
    margin-right: auto;
    color: var(--bh-ink);
    text-decoration: none;
  }

  /* ---------- Mobile (default): bar = logo · CTA · menu button ---------- */
  .site-header__cta {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    font-size: var(--bh-text-xs);
    white-space: nowrap;
  }
  .site-header__toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--bh-border) solid var(--bh-ink);
    background: var(--bh-ink);
    color: var(--bh-honey);
    cursor: pointer;
  }
  .site-header__toggle-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Three-bar icon that turns into an X. */
  .site-header__toggle-icon,
  .site-header__toggle-icon::before,
  .site-header__toggle-icon::after,
  .site-header__toggle-icon > span {
    display: block;
    width: 1.25rem;
    height: 3px;
    background: currentColor;
    transition:
      transform var(--bh-fast) var(--bh-ease),
      opacity var(--bh-fast) var(--bh-ease);
  }
  .site-header__toggle-icon {
    position: relative;
    background: transparent;
  }
  .site-header__toggle-icon::before,
  .site-header__toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .site-header__toggle-icon::before {
    top: -7px;
  }
  .site-header__toggle-icon::after {
    top: 7px;
  }
  [data-menu-open='true'] .site-header__toggle-icon > span {
    opacity: 0;
  }
  [data-menu-open='true'] .site-header__toggle-icon::before {
    transform: translateY(7px) rotate(45deg);
  }
  [data-menu-open='true'] .site-header__toggle-icon::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Menu panel: drops below the bar, full width. */
  .site-header__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    background: var(--bh-honey);
    border-top: var(--bh-border) solid var(--bh-ink);
    border-bottom: var(--bh-border) solid var(--bh-ink);
    box-shadow: 0 8px 0 var(--bh-ink);
  }
  /* With JS the panel is a disclosure; without JS it stays visible. */
  :global(.js) [data-menu-open='false'] .site-header__nav {
    display: none;
  }
  .site-header__links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__links li + li {
    border-top: var(--bh-border-thin) solid var(--bh-ink);
  }
  .site-header__link {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.75rem var(--bh-gutter);
    color: var(--bh-ink);
    font-size: var(--bh-text-lg);
    font-stretch: 112%;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }
  .site-header__link:hover,
  .site-header__link:focus-visible {
    background: var(--bh-ink);
    color: var(--bh-honey);
  }
  .site-header__lang {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.75rem var(--bh-gutter);
    border-top: var(--bh-border) solid var(--bh-ink);
    background: var(--bh-paper);
    color: var(--bh-ink);
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .site-header__lang:hover {
    background: var(--bh-ink);
    color: var(--bh-honey);
  }

  /* Narrow phones (≤ 368px): logo mark only, so the bar stays on one line
     with its gutter. The link keeps its aria-label. */
  @media (max-width: 23rem) {
    .site-header__brand :global(.home-logo__word) {
      display: none;
    }
    .site-header__cta {
      padding-inline: 0.625rem;
    }
  }

  @media (min-width: 40rem) {
    .site-header__cta {
      padding-inline: 1.125rem;
      font-size: var(--bh-text-sm);
    }
  }

  /* ---------- Desktop: inline nav, no toggle ---------- */
  @media (min-width: 64rem) {
    .site-header__bar {
      gap: 1rem;
      min-height: 4.5rem;
    }
    .site-header__toggle {
      display: none;
    }
    .site-header__nav,
    :global(.js) [data-menu-open='false'] .site-header__nav {
      position: static;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: transparent;
      border: 0;
      box-shadow: none;
    }
    .site-header__links {
      display: flex;
      gap: 0.25rem;
    }
    .site-header__links li + li {
      border: 0;
    }
    .site-header__link {
      min-height: 2.75rem;
      padding: 0.5rem 0.75rem;
      font-size: var(--bh-text-sm);
      font-weight: 800;
      white-space: nowrap;
    }
    .site-header__lang {
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0;
      border: var(--bh-border) solid var(--bh-ink);
      background: transparent;
    }
  }
</style>

<script>
  import { initMenu } from '../../scripts/menu';
  initMenu();
</script>
