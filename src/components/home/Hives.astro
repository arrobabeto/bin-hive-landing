---
import SectionHeader from '../ui/SectionHeader.astro';
import { bf } from '../../lib/bsi';
import type { HomeContent } from '../../lib/home-schema';

interface Props {
  content: HomeContent['hives'];
  anchor: string;
  index: number;
  total: number;
}
const { content, anchor, index, total } = Astro.props;
const glyphs: Record<string, string> = { instagram: 'IG', tiktok: 'TT', youtube: 'YT', x: 'X' };
---

<section id={anchor} class="home-section home-hives" aria-labelledby={`${anchor}-h`} {...bf('home.hives.shell', 'container')}>
  <div class="home-container">
    <SectionHeader section="hives" index={index} total={total} eyebrow={content.eyebrow} heading={content.heading} headingId={`${anchor}-h`} intro={content.intro} />
    <ul class="home-hives__grid">
      {
        content.items.map((hive) => (
          <li class="home-card home-card--lift home-hives__card" data-reveal>
            <span class="home-hives__cell home-hex" aria-hidden="true">
              {glyphs[hive.id] ?? hive.title.slice(0, 2)}
            </span>
            <h3 class="home-h3" {...bf(`home.hives.${hive.id}_title`, 'copy')}>{hive.title}</h3>
            <p class="home-hives__tag home-mono" {...bf(`home.hives.${hive.id}_tagline`, 'copy')}>{hive.tagline}</p>
            <p class="home-text" {...bf(`home.hives.${hive.id}_description`, 'copy')}>{hive.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .home-hives__grid {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-hives__card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 2rem;
  }
  .home-hives__cell {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 5.2rem;
    margin-bottom: 0.5rem;
    background: var(--bh-honey);
    font-stretch: 125%;
    font-weight: 900;
    font-size: 1.375rem;
    transition: background-color var(--bh-fast) var(--bh-ease);
  }
  .home-hives__card:hover .home-hives__cell {
    background: var(--bh-ink);
    color: var(--bh-honey);
  }
  .home-hives__tag {
    justify-self: start;
    margin: 0;
    padding: 0.25rem 0.5rem;
    background: var(--bh-ink);
    color: var(--bh-honey);
    font-size: var(--bh-text-sm);
    font-weight: 700;
    text-transform: uppercase;
  }
  @media (min-width: 40rem) {
    .home-hives__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .home-hives__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
