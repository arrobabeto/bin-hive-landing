# MailerLite (ADR-004). Read ONLY on the server by /api/waitlist.json (Vercel
# function) through astro:env — the API key never reaches the browser.
# The build fails if either is missing (validateSecrets: true).
#
# MailerLite → Integrations → API → Generate new token
MAILERLITE_API_KEY=your-mailerlite-api-key
# MailerLite → Subscribers → Groups → (Bin Hive group) → id in the URL
PUBLIC_MAILERLITE_GROUP_ID=your-mailerlite-group-id
