# Public by design: MailerLite embedded-form ids are visible in the generated form HTML.
# Find them in MailerLite → Forms → (your form) → Embed → HTML code:
#   https://assets.mailerlite.com/jsonp/<ACCOUNT_ID>/forms/<FORM_ID>/subscribe
PUBLIC_MAILERLITE_ACCOUNT_ID=your-mailerlite-account-id
PUBLIC_MAILERLITE_FORM_ID=your-mailerlite-form-id
